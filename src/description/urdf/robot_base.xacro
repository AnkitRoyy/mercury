<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="base">

    <!-- ================= DIMENSIONS ================= -->
    <xacro:property name="base_length"       value="0.55"/>
    <xacro:property name="base_width"        value="0.48"/>
    <xacro:property name="base_height"       value="0.29"/>
    <xacro:property name="ground_clearance"  value="0.09"/>
    <xacro:property name="base_mass"         value="28.0"/>

    <!-- Wheel diameter = 32 cm -> radius = 16 cm (0.16 m) -->
    <xacro:property name="wheel_radius"      value="0.16"/>
    <xacro:property name="wheel_width"       value="0.06"/>
    <xacro:property name="wheel_mass"        value="1.2"/>

    <!-- Drive wheels position (rear) -->
    <xacro:property name="wheel_x_offset"    value="-0.15"/>
    <xacro:property name="wheel_y_offset"    value="0.27"/> <!-- Separation = 0.54 m -->

    <!-- Front castor (touches ground at z = 0) -->
    <xacro:property name="castor_radius"     value="0.039"/>
    <xacro:property name="castor_x_offset"   value="0.20"/>
    <xacro:property name="castor_strut_height"
                    value="${ground_clearance - 2 * castor_radius}"/>

    <!-- Base box center z relative to ground (z=0): 0.09 + 0.29/2 = 0.235m -->
    <xacro:property name="base_z_center"     value="${ground_clearance + base_height / 2}"/>

    <!-- ================= BASE LINK ================= -->
    <link name="base_link">

      <visual>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <origin xyz="0 0 ${base_z_center}" rpy="0 0 0"/>
        <material name="body_color">
          <color rgba="0.15 0.15 0.18 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <origin xyz="0 0 ${base_z_center}" rpy="0 0 0"/>
      </collision>

      <inertial>
        <mass value="${base_mass}"/>
        <origin xyz="-0.069 0.0 ${base_z_center}"/>
        <inertia ixx="1.708" iyy="2.802" izz="1.732"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

    </link>

    <gazebo reference="base_link">
      <self_collide>false</self_collide>
    </gazebo>

    <!-- ================= DRIVE WHEEL MACRO ================= -->
    <xacro:macro name="wheel" params="name x y">

      <link name="${name}_link">

        <visual>
          <origin rpy="1.5708 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
          <material name="wheel_black">
            <color rgba="0.05 0.05 0.05 1"/>
          </material>
        </visual>

        <collision>
          <origin rpy="1.5708 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </collision>

        <inertial>
          <mass value="${wheel_mass}"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0.01" iyy="0.01" izz="0.005" ixy="0" ixz="0" iyz="0"/>
        </inertial>

      </link>

      <joint name="${name}_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}_link"/>
        <origin xyz="${x} ${y} ${wheel_radius}"/>
        <axis xyz="0 1 0"/>
      </joint>

    </xacro:macro>

    <!-- Two drive wheels (rear) -->
    <xacro:wheel name="left_wheel"
                 x="${wheel_x_offset}"
                 y="${wheel_y_offset}"/>

    <xacro:wheel name="right_wheel"
                 x="${wheel_x_offset}"
                 y="-${wheel_y_offset}"/>

    <!-- ================= CASTOR WHEEL (FRONT) ================= -->
    <!-- Vertical strut connecting chassis bottom to castor ball -->
    <link name="castor_strut_link">
      <visual>
        <geometry>
          <cylinder radius="0.012" length="${castor_strut_height}"/>
        </geometry>
        <origin xyz="0 0 ${-castor_strut_height/2}"/>
        <material name="strut_gray">
          <color rgba="0.4 0.4 0.4 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.012" length="${castor_strut_height}"/>
        </geometry>
        <origin xyz="0 0 ${-castor_strut_height/2}"/>
      </collision>

      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="castor_strut_joint" type="fixed">
      <parent link="base_link"/>
      <child link="castor_strut_link"/>
      <origin xyz="${castor_x_offset} 0 ${ground_clearance}"/>
    </joint>

    <!-- Castor ball – touches ground at z=0 -->
    <link name="castor_wheel_link">
      <visual>
        <geometry>
          <sphere radius="${castor_radius}"/>
        </geometry>
        <material name="castor_gray">
          <color rgba="0.6 0.6 0.6 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${castor_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="castor_wheel_joint" type="fixed">
      <parent link="castor_strut_link"/>
      <child link="castor_wheel_link"/>
      <origin xyz="0 0 ${-castor_strut_height - castor_radius}"/>
    </joint>

    <!-- Zero friction so castor slides freely in Gazebo -->
    <gazebo reference="castor_wheel_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <slip1>1.0</slip1>
      <slip2>1.0</slip2>
      <fdir1>0 0 1</fdir1>
    </gazebo>

    <!-- ================= IMU ================= -->
    <link name="imu_link">
      <visual>
        <geometry>
          <box size="0.03 0.03 0.02"/>
        </geometry>
        <origin xyz="0 0 0"/>
        <material name="orange">
          <color rgba="1 0.5 0 1"/>
        </material>
      </visual>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 ${ground_clearance + base_height + 0.01}"/>
    </joint>

    <!-- ================= GPS ================= -->
    <link name="gps_link">
      <visual>
        <geometry>
          <box size="0.03 0.03 0.02"/>
        </geometry>
        <origin xyz="0 0 0"/>
        <material name="white">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gps_link"/>
      <origin xyz="0 0 ${ground_clearance + base_height + 0.05}"/>
    </joint>

    <!-- ================= LIDAR (laser_link) ================= -->
    <link name="laser_link">
      <visual>
        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0"/>
        <material name="gray">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0"/>
      </collision>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="0.22 0 ${ground_clearance + base_height + 0.03}" rpy="0 0 3.14159"/>
    </joint>

    <!-- ================= PAN LINK ================= -->
    <link name="pan_link">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.02"/>
        </geometry>
        <material name="red">
          <color rgba="1 0 0 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="pan_joint" type="revolute">
      <parent link="base_link"/>
      <child link="pan_link"/>
      <origin xyz="0.12 0 ${ground_clearance + base_height + 0.01}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="5" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- ================= TILT LINK ================= -->
    <link name="tilt_link">
      <visual>
        <geometry>
          <box size="0.04 0.04 0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.04 0.04 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.005" iyy="0.005" izz="0.005"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="tilt_base_joint" type="revolute">
      <parent link="pan_link"/>
      <child link="tilt_link"/>
      <origin xyz="0 0 0.05"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="5" velocity="1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- ================= TURRET CAMERA ================= -->
    <link name="turret_camera_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
        <material name="Red">
          <color rgba="1 0 0 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.005" iyy="0.005" izz="0.005"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="turret_camera_joint" type="fixed">
      <parent link="tilt_link"/>
      <child link="turret_camera_link"/>
      <origin xyz="0 0 0.03"/>
    </joint>

    <!-- ================= LANE CAMERA ================= -->
    <link name="camera_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 1 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.005" iyy="0.005" izz="0.005"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="0.15 0 1" rpy="0 0.25 0"/>
    </joint>

  </xacro:macro>

</robot>